FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl nodejs npm unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

COPY requirements-ui.txt ./

ENV PYTHONPATH="/app"

RUN uv pip install --system --no-cache -r requirements-ui.txt

COPY core/ /app/core/
COPY apps/ /app/apps/
COPY data/ /app/data/

WORKDIR /app/apps/reflex_app

# Reflex 0.10 in prod mode serves the frontend and the backend on one port (8001); the first start compiles the app
EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 CMD curl --fail http://localhost:8001/ping || exit 1

ENTRYPOINT ["reflex", "run", "--env", "prod"]
