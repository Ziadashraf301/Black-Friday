FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

COPY requirements.txt ./

ENV PYTHONPATH="/app"
# uv defaults to a 30s download timeout; large wheels (pyarrow, onnxruntime, ...) time out on slow links
ENV UV_HTTP_TIMEOUT=300

# The cache mount keeps downloaded wheels between builds (outside the image layer), so a failed or repeated build
# does not download everything again. -v prints each package as it downloads.
ENV UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.cache/uv uv pip install --system -v -r requirements.txt

COPY core/ /app/core/
COPY apps/ /app/apps/
COPY ml/ /app/ml/
COPY ai/ /app/ai/
COPY evaluation/ /app/evaluation/

# models/ and data/ are bind-mounted by docker-compose (models/ is gitignored, so it is not in a clean checkout).

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
