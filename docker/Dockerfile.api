FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

# Exact, hashed versions (make lock regenerates them from requirements.txt)
COPY requirements.lock ./

ENV PYTHONPATH="/app"
# uv defaults to a 30s download timeout; large wheels (pyarrow, onnxruntime, ...) time out on slow links
ENV UV_HTTP_TIMEOUT=300

# The cache mount keeps downloaded wheels between builds (outside the image layer), so a failed or repeated build
# does not download everything again. -v prints each package as it downloads.
ENV UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.cache/uv uv pip install --system -v --require-hashes -r requirements.lock

COPY core/ /app/core/
COPY apps/ /app/apps/
COPY ml/ /app/ml/
COPY ai/ /app/ai/
COPY evaluation/ /app/evaluation/

# models/ and data/ are bind-mounted by docker-compose (models/ is gitignored, so it is not in a clean checkout).

# Run as a non-root user (INF-12). The bind-mounted code, models/ and data/ only need to be readable by it; on a
# Linux host build with APP_UID/APP_GID = your own id (`id -u` / `id -g`) if those files are not world-readable.
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --gid ${APP_GID} app && useradd --uid ${APP_UID} --gid ${APP_GID} --create-home --shell /usr/sbin/nologin app
# Logs are written inside the container; bytecode is not written into the bind mounts
ENV PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /app/logs && chown -R app:app /app/logs
USER app

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-proxy-headers"]
