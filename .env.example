# ============================================================================
# Black Friday v2 - Environment Configuration Template (.env.example)
# ============================================================================

# Project Metadata
PROJECT_NAME=Black-Friday-v2
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Storage & Raw Datasets
DATA_DIR=data
TRAIN_DATA_PATH=data/train.csv
TEST_DATA_PATH=data/test.csv

# PostgreSQL Analytical Data Warehouse & MLflow Backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_DB_NAME=fridayblack
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow123

# MinIO Object Storage (S3-Compatible Artifact Store)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MLFLOW=mlflow-artifacts
MINIO_BUCKET_DVC=blackfriday-dvc

# Redis Persistent Cache Configuration (6 Hours = 21600 Seconds)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=21600


# MLflow Tracking Server & Model Registry
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=black-friday-sales-prediction
MLFLOW_MODEL_NAME=blackfriday-pricing-regressor
MLFLOW_IMPUTER_MODEL_NAME=blackfriday-missforest-imputer

# AWS / S3 Credentials for MLflow Client (Points to MinIO)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123

# Reproducibility & Random Seed (Optional, default=1234)
RANDOM_SEED=1234

# MissForest Imputation Configuration (Optional, defaults provided)
IMPUTER_N_ESTIMATORS=30
IMPUTER_MAX_ITER=5
IMPUTER_SAMPLE_SIZE=5000000
IMPUTER_MAX_DEPTH=12
IMPUTER_MIN_SAMPLES_LEAF=5
IMPUTER_N_JOBS=-1

# Model Engine & Governance
DEFAULT_REGRESSION_MODEL=random_forest
CHAMPION_MIN_R2_THRESHOLD=0.7400
CHAMPION_MIN_IMPROVEMENT_DELTA=0.0050

# Decision Tree Regressor Hyperparameters
DT_MAX_DEPTH=16
DT_MIN_SAMPLES_LEAF=5

# Random Forest Regressor Hyperparameters
RF_N_ESTIMATORS=100
RF_MAX_FEATURES=4
RF_MAX_DEPTH=16
RF_MIN_SAMPLES_LEAF=5
RF_N_JOBS=-1

# LightGBM Regressor Hyperparameters
LGBM_N_ESTIMATORS=250
LGBM_LEARNING_RATE=0.08
LGBM_NUM_LEAVES=255
LGBM_MAX_DEPTH=-1
LGBM_N_JOBS=-1

# Drift Monitoring Thresholds
DRIFT_DATASET_THRESHOLD=0.30
DRIFT_TARGET_PSI_THRESHOLD=0.20

# API & Streamlit Serving
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501

GEMINI_API_KEY=